# Copy this file to .env and fill in the values (Supabase → Project Settings → API Keys).
# .env is ignored by git: never commit the secret key.

PORT=5000

# Supabase project
SUPABASE_URL=https://your-project-id.supabase.co
# Secret key: server only. It bypasses Row Level Security, never put it in the frontend.
SUPABASE_SECRET_KEY=sb_secret_...
# Publishable key: safe for browsers. Not used by the backend yet (kept for the login work).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# TEMPORARY, until login / password exist:
# the admin dashboard identifies the admin by email only (header X-User-Email),
# and the account must have role = admin or super_admin in the database.
# Keep it false in production.
TEMP_EMAIL_LOGIN=true

# Only for npm run db:setup (runs supabase/schema.sql + seed.sql). Supabase → Connect → Session pooler.
# Never commit the real value.
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
